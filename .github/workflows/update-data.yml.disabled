name: 拉取慧运营数据

on:
  # 北京时间每天 00:05 = UTC 前一天 16:05；云端执行，电脑关机也不影响。
  schedule:
    - cron: "5 16 * * *"
  # Actions 页面可手动立即刷新
  workflow_dispatch:

permissions:
  contents: write

# 同一时间只允许一轮刷新，避免数据文件互相覆盖。
concurrency:
  group: hyy-data-refresh
  cancel-in-progress: false

jobs:
  refresh:
    runs-on: ubuntu-latest
    timeout-minutes: 180
    env:
      HY_ENT: ${{ secrets.HY_ENT }}
      HY_USERNAME: ${{ secrets.HY_USERNAME }}
      HY_PASSWORD: ${{ secrets.HY_PASSWORD }}
      HY_API_BASE: ${{ secrets.HY_API_BASE }}
      HY_IMG_BASE: ${{ secrets.HY_IMG_BASE }}

    steps:
      - name: 检出仓库
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: 配置 Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.11"
          cache: pip
          cache-dependency-path: scripts/requirements.txt

      - name: 安装依赖
        run: pip install -r scripts/requirements.txt

      - name: 检查慧运营凭据
        shell: bash
        run: |
          test -n "$HY_USERNAME" || { echo "错误：缺少 Secrets.HY_USERNAME"; exit 1; }
          test -n "$HY_PASSWORD" || { echo "错误：缺少 Secrets.HY_PASSWORD"; exit 1; }
          test -n "$HY_API_BASE" || { echo "错误：缺少 Secrets.HY_API_BASE"; exit 1; }
          echo "凭据配置完整"

      # 原始报告与主数据在同一轮生成，避免两个工作流抢接口、互相覆盖。
      - name: 采集原始报告
        run: python scripts/collect_raw.py

      - name: 生成主数据与报表明细
        run: python scripts/fetch_data.py

      # 脚本内部允许单模块记录错误，但发布前必须拦截，不能出现“工作流成功、数据其实没更新”。
      - name: 校验刷新结果
        shell: bash
        run: |
          python - <<'PY'
          import json
          from pathlib import Path

          path = Path("data/meta.json")
          if not path.exists():
              raise SystemExit("错误：未生成 data/meta.json")
          meta = json.loads(path.read_text(encoding="utf-8"))
          modules = meta.get("modules") or {}
          required = ["data", "reportDetails", "unqualified", "trends", "trends_video", "rankings"]
          errors = []
          for name in required:
              value = modules.get(name)
              if value is None:
                  errors.append(f"{name}: 缺失")
              elif isinstance(value, dict) and value.get("ok") is False:
                  errors.append(f"{name}: {value.get('error', '失败')}")
              elif isinstance(value, dict):
                  bad = [k for k, v in value.items() if v is False or (isinstance(v, str) and v)]
                  if bad:
                      errors.append(f"{name}: {bad}")
          if errors:
              raise SystemExit("刷新结果校验失败：" + "；".join(errors))
          print("刷新结果校验通过")
          print("generatedAt:", meta.get("generatedAt"))
          print("date range:", meta.get("startDate"), "~", meta.get("endDate"))
          print("modules:", json.dumps(modules, ensure_ascii=False))
          PY

      - name: 提交并发布数据
        shell: bash
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "github-actions[bot]@users.noreply.github.com"
          git add -A data/
          if git diff --cached --quiet; then
            echo "数据无变化，跳过提交"
            exit 0
          fi
          # 先提交本轮结果，再拉取远端并变基；不能在暂存区有内容时直接 pull --rebase。
          git commit -m "chore(data): 更新巡检数据 $(date -u +'%Y-%m-%d %H:%M UTC')"
          git pull --rebase origin main
          git push origin main
